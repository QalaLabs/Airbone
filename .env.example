# ─── Airborne Aviation Academy - Marketing Site Environment Template ──────────
# Copy to .env.local for local dev. Set all REQUIRED vars in Vercel before deploy.
# Never commit real secrets.
#
# ⚠️ ENVIRONMENT BOUNDARY: the marketing project must NEVER contain the admin
# app's secrets (DATABASE_URL, DIRECT_URL, AUTH_SECRET, AUTH_URL, SUPABASE_SERVICE_ROLE_KEY).
# The marketing app only talks to the admin app over HTTP (ADMIN_API_URL).

# ─── Admin Backend (REQUIRED) ────────────────────────────────────────────────
# URL of the deployed admin Next.js app (no trailing slash).
# Must be an absolute http(s) URL — an empty or malformed value is a hard error
# on the lead intake path, not a silent fallback.
ADMIN_API_URL="https://admin.airborneacademy.in"

# Shared secret for admin public API - must match admin's PUBLIC_INTAKE_KEY
PUBLIC_INTAKE_KEY="replace-with-same-value-as-admin-PUBLIC_INTAKE_KEY"

# ─── Org Identity (OPTIONAL - has safe default) ───────────────────────────────
# Org slug for public data queries (default: airborne-aviation)
PUBLIC_ORG_SLUG="airborne-aviation"

# ─── Lead Durability Fallback (RECOMMENDED for production) ───────────────────
# When the admin backend is unreachable (timeout / 5xx), leads are persisted to
# the Supabase `fallback_leads` table and auto-recovered by the admin's Inngest
# cron. Without these the fallback path cannot store anything (lead → 500).
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="replace-with-supabase-anon-key"

# ─── Omnichannel Communication (OPTIONAL) ────────────────────────────────────
# n8n webhook - triggers WhatsApp nurture sequence on lead capture
N8N_WHATSAPP_WEBHOOK=""

# Vapi / Bland.ai - outbound voice qualification call within 120 s of lead submit
VOICE_AI_WEBHOOK=""
VOICE_AI_TOKEN=""

# ─── CRM Push (OPTIONAL - server-side only) ───────────────────────────────────
# Groweon CRM capture endpoint for lead forwarding
CRM_ENDPOINT=""
CRM_COMPANY="Airborne Aviation"
CRM_SOURCE="Airborne Website"

# ─── OTP (OPTIONAL) ───────────────────────────────────────────────────────────
# Salt for OTP hashing. Marketing-only value — do NOT reuse the admin AUTH_SECRET.
# Falls back to AUTH_SECRET (legacy) then a built-in dev salt when unset.
OTP_HASH_SECRET=""

# ─── Upstream tuning (OPTIONAL) ───────────────────────────────────────────────
# Timeout (ms) for the admin lead-intake fetch. Default: 10000
UPSTREAM_FETCH_TIMEOUT="10000"

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV="production"
